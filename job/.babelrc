{
  "sourceMaps": true,
  "presets": [
    "@babel/preset-typescript",
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "current"
        }
      }
    ]
  ],
  "plugins": [
    [
      "module-resolver",
      {
        "alias": {
          "@middleware": "./src/middleware",
          "@error": "./src/error",
          "@security": "./src/security",
          "@schema": "./src/schema",
          "@upload": "./src/upload",
          "@root": "./"
        }
      }
    ]
  ],

  "ignore": ["**/*.test.ts"]
}
